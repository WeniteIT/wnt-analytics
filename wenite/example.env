# WENITE – Umgebungsvariablen für wnt-analytics (Umami 3.x)
# Diese Datei ist nur eine Vorlage. Echte Werte gehören in die Vercel-Projekteinstellungen
# (Settings → Environment Variables) bzw. lokal in wenite/.env (wird von Git ignoriert).

# --- Datenbank (Supabase, Region Frankfurt) ----------------------------------------
# Laufzeit: Transaction Pooler (Port 6543). Für viele kurzlebige Vercel-Funktionen gedacht.
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORT>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Migrationen beim Build: Session Pooler (Port 5432) – gleicher Host, anderer Port.
# Umami nutzt diese URL nur für "prisma migrate deploy" (scripts/check-db.js).
# Hinweis: Die "Direct connection" von Supabase ist ohne IPv4-Add-on nur per IPv6 erreichbar,
# deshalb hier der Session Pooler.
DIRECT_DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORT>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- Sicherheit -----------------------------------------------------------------------
# Pflicht. Erzeugen mit: openssl rand -hex 32   (PowerShell: siehe README)
APP_SECRET=<64-stelliger-hex-wert>
# Für Zwei-Faktor-Login. Erzeugen wie APP_SECRET, aber einen ANDEREN Wert nehmen.
TWO_FACTOR_ENCRYPTION_KEY=<64-stelliger-hex-wert>

# --- Tracker (unauffällige Namen, weniger Adblocker-Treffer) ---------------------------
# Script dann erreichbar unter https://analytics.wenite.de/wnt.js
TRACKER_SCRIPT_NAME=wnt.js
# Endpunkt, an den der Tracker sendet (statt /api/send)
COLLECT_API_ENDPOINT=/api/wnt

# --- Datenschutz ------------------------------------------------------------------------
# Wie oft der Salt für die Besucher-Kennung wechselt: daily | weekly | monthly (Standard: monthly)
# daily = Besucher werden nicht über Tage wiedererkannt (datenschutzfreundlicher,
#         dafür keine tagesübergreifenden Journeys). Entscheidung siehe README.
SALT_ROTATION=daily
# Optional: eigene IPs nicht zählen (kommagetrennt, CIDR möglich), z. B. Büro-IP
# IGNORE_IP=

# --- Betrieb ----------------------------------------------------------------------------
# Keine Telemetrie an umami.is, keine Update-Hinweise in der Oberfläche
DISABLE_TELEMETRY=1
DISABLE_UPDATES=1
# Oberfläche standardmäßig auf Deutsch
DEFAULT_LOCALE=de-DE
# HSTS-Header setzen
FORCE_SSL=1
